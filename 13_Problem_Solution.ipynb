   "source": [
    "# Drawing Book\n",
    "\n",
    "n = int(input())   # total number of pages\n",
    "k = int(input())   # page to reach\n",
    "\n",
    "# Turns from front\n",
    "front_turns = k // 2\n",
    "\n",
    "# Turns from back\n",
    "back_turns = (n // 2) - (k // 2)\n",
    "\n",
    "# Minimum turns\n",
    "print(min(front_turns, back_turns))\n"
   ]

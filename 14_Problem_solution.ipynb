   "source": [
    "# Counting valleys\n",
    "\n",
    "n=int(input())\n",
    "valley=str(input())\n",
    "count=0\n",
    "valleys=0\n",
    "for ch in valley:\n",
    "    if (ch=='U'):\n",
    "        count+=1\n",
    "        if count==0:\n",
    "            valleys+=1\n",
    "    elif(ch=='D'):\n",
    "        count-=1\n",
    "print(valleys)"
   ]

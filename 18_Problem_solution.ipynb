   "source": [
    "n = int(input())\n",
    "arr = list(map(int, input().split()))\n",
    "\n",
    "arr.sort()\n",
    "\n",
    "max_len = 0\n",
    "start = 0\n",
    "\n",
    "for end in range(n):\n",
    "    while arr[end] - arr[start] > 1:\n",
    "        start += 1\n",
    "    max_len = max(max_len, end - start + 1)\n",
    "\n",
    "print(max_len)\n"
   ]

   "source": [
    "# The Hurdle Race ----\n",
    "\n",
    "n, k = map(int, input().split())\n",
    "height = list(map(int, input().split()))\n",
    "\n",
    "highest_hurdle = max(height)   \n",
    "\n",
    "if highest_hurdle > k:\n",
    "    print(highest_hurdle - k)\n",
    "else:\n",
    "    print(0)\n",
    "\n"
   ]

   "source": [
    "# Day of the Programmer\n",
    "\n",
    "year = int(input())\n",
    "\n",
    "if (year % 400 == 0) or (year % 4 == 0 and year % 100 != 0):\n",
    "    print(f\"12.09.{year}\")\n",
    "elif(year<=2000 and year%100==0):\n",
    "    print(f\"12.09.{year}\")\n",
    "elif(year==1918):\n",
    "    print(f\"26.09.{year}\")\n",
    "else:\n",
    "    print(f\"13.09.{year}\")"
   ]

   "source": [
    "# Sale by Match\n",
    "\n",
    "n=int(input())\n",
    "arr=list(map(int,input().split()))\n",
    "freq={}\n",
    "count=0\n",
    "\n",
    "# Check frequency\n",
    "\n",
    "for i in arr:\n",
    "    freq[i]=freq.get(i,0)+1\n",
    "\n",
    "# count pairs\n",
    "for value in freq.values():\n",
    "    count += value // 2\n",
    "\n",
    "print(count)\n"
   ]
  }
 ],

   "source": [
    "# Divisible sum pair\n",
    "\n",
    "n,k=map(int,input().split())\n",
    "arr=list(map(int,input().split()))\n",
    "pairs=[]\n",
    "counts=0\n",
    "for i in range(len(arr)):\n",
    "    for j in range(i+1,len(arr)):\n",
    "        if (arr[i]+arr[j])%k==0:\n",
    "            counts+=1\n",
    "            pairs.append((arr[i],arr[j]))\n",
    "print(counts)\n",
    "    "
   ]
  }
 ],
